{
  "name": "fief",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i styles/admin.css -o fief/static/admin.css --minify && tailwindcss -i styles/auth.css -o fief/static/auth.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "test": "node --test js/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "codemirror": "^6.0.2",
    "htmx.org": "^2.0.11",
    "hyperscript.org": "^0.9.94",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  }
}
