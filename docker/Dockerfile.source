# Build browser assets with the active Node LTS release.
FROM node:26.13.0-bookworm-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY js ./js
COPY scripts ./scripts
COPY styles ./styles
COPY tailwind.config.mjs ./
COPY fief/templates ./fief/templates
RUN mkdir -p fief/static && npm test && npm run build

FROM redis:8.10.3 AS redis

# Build the wheel and install exactly the runtime dependencies from uv.lock.
FROM python:3.14-slim-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv
WORKDIR /build
ENV UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --group docker --no-install-project
COPY . .
COPY --from=frontend /build/fief/static/ ./fief/static/
RUN uv run --locked pybabel compile --domain=messages --directory=fief/locale \
    && uv build --wheel --no-build-isolation --out-dir /dist \
    && uv export --locked --no-dev --group docker --no-emit-project --output-file /requirements.txt \
    && uv venv /opt/venv \
    && uv pip sync --python /opt/venv/bin/python --require-hashes /requirements.txt \
    && uv pip install --python /opt/venv/bin/python --no-deps /dist/*.whl

FROM python:3.14-slim-trixie
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    DATABASE_LOCATION=/data/db \
    SECRETS_DIR=/run/secrets \
    PORT=8000
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libsystemd0 libzstd1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/db /run/secrets \
    && python -m pip uninstall --yes pip setuptools
COPY --from=redis /usr/local/bin/redis-server /usr/local/bin/redis-server
COPY --from=builder /opt/venv /opt/venv
COPY docker/supervisord.conf /etc/supervisord.conf
EXPOSE 8000

ARG SENTRY_RELEASE
ENV SENTRY_DSN_SERVER=https://368564902247d300629e80ceb8bccf1f@o4512337837686784.ingest.us.sentry.io/4512337867112448 \
    SENTRY_DSN_WORKER=https://368564902247d300629e80ceb8bccf1f@o4512337837686784.ingest.us.sentry.io/4512337867112448 \
    SENTRY_RELEASE=${SENTRY_RELEASE}

CMD ["supervisord", "-c", "/etc/supervisord.conf"]
